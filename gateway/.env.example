COVENANT_RPC_UPSTREAM=https://robinhood-rpc.publicnode.com
# Optional: comma-separated list for RPC failover (settlement path only —
# see facilitator.js). Recommended in production so one flaky public RPC
# doesn't stall settlement: COVENANT_RPC_UPSTREAM=https://a,https://b
COVENANT_PORT=8792

# Settlement wallet (facilitator). Agents approve THIS address; it pulls USDG via transferFrom.
# Generate: node -e "console.log(require('ethers').Wallet.createRandom().privateKey)"
# Keep only a small hot float here; keep the bulk cold.
COVENANT_SETTLE_KEY=

# Default payTo for paid routes (0x0 until your distributor is live)
COVENANT_X402_PAYTO=0x0000000000000000000000000000000000000000

# Vault encryption pepper — SET THIS IN PRODUCTION (fallback derives from RPC URL)
COVENANT_VAULT_KEY=

# Comma-separated IPs of trusted reverse proxies (nginx/LB) allowed to set
# X-Forwarded-For for rate-limit accounting. Leave empty when the gateway is
# reached directly — otherwise clients can spoof the header and dodge
# per-IP rate limits (e.g. the 5-keys/hour guard on POST /keys).
COVENANT_TRUSTED_PROXIES=
