COVENANT_RPC_UPSTREAM=https://robinhood-rpc.publicnode.com
# Optional: comma-separated list for RPC failover (settlement path only —
# see facilitator.js). Recommended in production so one flaky public RPC
# doesn't stall settlement: COVENANT_RPC_UPSTREAM=https://a,https://b
COVENANT_PORT=8792
# Bind address — 127.0.0.1 is correct when something else on this host
# (nginx, a Cloudflare tunnel) fronts the gateway. Set to 0.0.0.0 inside a
# container, or 127.0.0.1 will be unreachable even with the port mapped.
COVENANT_HOST=127.0.0.1

# Additional settlement chains — each is independent and optional. Omit any
# of these and that chain just reports configured:false on GET /chains; the
# other chains (and the default Robinhood rail) keep working unaffected.
# Same comma-separated-failover syntax as COVENANT_RPC_UPSTREAM.
COVENANT_RPC_ETHEREUM=
COVENANT_RPC_BASE=
COVENANT_RPC_ARBITRUM=

# Settlement wallet (facilitator). Agents approve THIS address; it pulls USDG via transferFrom.
# Generate: node -e "console.log(require('ethers').Wallet.createRandom().privateKey)"
# Keep only a small hot float here; keep the bulk cold.
COVENANT_SETTLE_KEY=

# Solana (devnet) fee payer — enables /x402/solana/*. Base58-encoded 32-byte
# seed (the common "export private key" format from Phantom/Solflare/
# solana-keygen). Omit and /x402/solana/* reports configured:false; every
# other route works unaffected. See README "Solana support" for the
# devnet-only status and known gaps before funding this for real traffic.
# Generate: node -e "const{generateKeyPairSync}=require('crypto');const bs58=require('bs58').default||require('bs58');const kp=generateKeyPairSync('ed25519');console.log(bs58.encode(kp.privateKey.export({type:'pkcs8',format:'der'}).slice(-32)))"
COVENANT_SOLANA_FEE_PAYER_KEY=

# Default payTo for paid routes (0x0 until your distributor is live)
COVENANT_X402_PAYTO=0x0000000000000000000000000000000000000000

# Vault encryption pepper — SET THIS IN PRODUCTION (fallback derives from RPC URL)
COVENANT_VAULT_KEY=

# Comma-separated IPs of trusted reverse proxies (nginx/LB, or a
# Cloudflare Tunnel's cloudflared, which connects via plain loopback —
# 127.0.0.1) allowed to set X-Forwarded-For / CF-Connecting-IP for
# rate-limit accounting. Leave empty ONLY when the gateway is reached
# directly with no proxy/tunnel in front — otherwise EVERY real client
# behind that proxy collapses into ONE shared rate-limit bucket (found by
# audit: a Cloudflare Tunnel deployment with this left empty means one
# abusive client exhausts the budget for every other real client, since
# the gateway process only ever sees cloudflared's own loopback address
# as the "peer"). Set this to 127.0.0.1 for a Cloudflare Tunnel setup —
# cf-connecting-ip is then trusted (and preferred over x-forwarded-for,
# since Cloudflare's edge owns that header exclusively and rejects a
# client-spoofed value with its own "error code: 1000").
COVENANT_TRUSTED_PROXIES=
